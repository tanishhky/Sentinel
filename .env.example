# Sentinel — Environment variables template
# Copy to `.env` and override any of these as needed.
#
# By default Sentinel reads sibling repos checked out next to it
# (../PinSight, ../DriftEdge), so these are only needed if your repos
# live elsewhere. Use absolute paths.

# Data directories (read by Sentinel's Parquet readers)
# PINSIGHT_DATA_DIR=/abs/path/to/PinSight/data
# DRIFTEDGE_DATA_DIR=/abs/path/to/DriftEdge/data

# Log directories (tailed for the Logs tab SSE stream)
# PINSIGHT_LOG_DIR=/abs/path/to/PinSight/logs
# DRIFTEDGE_LOG_DIR=/abs/path/to/DriftEdge/logs

# Server
SENTINEL_HOST=127.0.0.1
SENTINEL_PORT=8765

# Refresh hint for the frontend (ms)
SENTINEL_REFRESH_MS=5000
